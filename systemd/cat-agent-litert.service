[Unit]
Description=cat-agent LiteRT CORE
After=cat-agent-task-system.service

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=/opt/cat-agent
ExecStart=/opt/cat-agent/start_litert_agent.sh e2b-cpu
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
