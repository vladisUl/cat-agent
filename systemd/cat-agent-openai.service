[Unit]
Description=cat-agent OpenAI CORE
After=network-online.target cat-agent-task-system.service

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=/opt/cat-agent
ExecStart=/opt/cat-agent/start_openai_agent.sh
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
